# PostgreSQL
POSTGRES_USER=chathub
POSTGRES_PASSWORD=chathub
POSTGRES_DB=chathub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Porta publicada no host pelo docker-compose (não altere POSTGRES_PORT; o app no container usa 5432)
POSTGRES_HOST_PORT=5434

# App
PORT=8765
WEB_PORT=5173

# Opcional: sobrescreve a URL montada a partir das variáveis acima
# DATABASE_URL=postgresql://chathub:chathub@localhost:5432/chathub
